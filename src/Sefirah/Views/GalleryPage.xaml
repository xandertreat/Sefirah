<Page
    x:Class="Sefirah.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sefirah.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Sefirah.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sefirah.Data.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EmptyObjectToVisibilityConverter x:Key="EmptyObjectToVisibilityConverter" />

        <DataTemplate x:Key="MediaTileTemplate" x:DataType="models:MediaItem">
            <Grid
                Width="152"
                Height="152"
                IsRightTapEnabled="True"
                DataContextChanged="MediaTile_DataContextChanged"
                Loaded="MediaTile_Loaded"
                ToolTipService.ToolTip="{x:Bind Description}"
                AutomationProperties.Name="{x:Bind Description}">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Click="OpenMediaClick"
                            DataContext="{x:Bind}"
                            Text="{helpers:ResourceString Name=Open}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="SaveCopyClick"
                            DataContext="{x:Bind}"
                            Text="{helpers:ResourceString Name=SaveCopy}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="DeleteMediaClick"
                            DataContext="{x:Bind}"
                            Text="{helpers:ResourceString Name=Delete}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                    <Grid>
                        <FontIcon
                            x:Name="Placeholder"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="{x:Bind VideoGlyph}"
                            AutomationProperties.AccessibilityView="Raw" />
                        <Image
                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource EmptyObjectToVisibilityConverter}}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Border>

                <!-- Videos get a play badge over the tile -->
                <Border
                    Margin="8"
                    Padding="6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4"
                    Visibility="{x:Bind IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon FontSize="12" Foreground="White" Glyph="&#xE768;" AutomationProperties.AccessibilityView="Raw" />
                </Border>

                <!-- Keyboard/AT path to the same menu the pointer opens with a right tap -->
                <Button
                    Margin="4"
                    Padding="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="0"
                    Click="MoreOptionsClick"
                    AutomationProperties.Name="{helpers:ResourceString Name=TileMoreOptions}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{helpers:ResourceString Name=Gallery}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <ToggleButton
                    x:Name="AllButton"
                    Click="AllClick"
                    Content="{helpers:ResourceString Name=AllMedia}"
                    IsChecked="True" />
                <ToggleButton x:Name="PhotosButton" Click="PhotosClick" Content="{helpers:ResourceString Name=Photos}" />
                <ToggleButton x:Name="VideosButton" Click="VideosClick" Content="{helpers:ResourceString Name=Videos}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshCommand}"
                ToolTipService.ToolTip="{helpers:ResourceString Name=Refresh}"
                AutomationProperties.Name="{helpers:ResourceString Name=Refresh}">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Button
                Grid.Column="1"
                Click="ClearStatusClick"
                AutomationProperties.Name="{helpers:ResourceString Name=Dismiss}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <GridView
                x:Name="MediaGrid"
                AutomationProperties.Name="{helpers:ResourceString Name=Gallery}"
                IsItemClickEnabled="True"
                KeyDown="MediaGrid_KeyDown"
                ItemClick="MediaGrid_ItemClick"
                ItemTemplate="{StaticResource MediaTileTemplate}"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="None" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEB9F;" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:ResourceString Name=NoMedia}" />
            </StackPanel>

            <ProgressRing
                Width="32"
                Height="32"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Page>
